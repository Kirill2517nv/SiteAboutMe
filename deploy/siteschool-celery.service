# lbm-srv: /etc/systemd/system/siteschool-celery.service – проверка кода.
# Контейнеры песочницы запускает этот процесс: lih в группе docker.
[Unit]
Description=Siteschool – Celery worker
After=network.target postgresql@16-siteschool.service redis-server.service docker.service

[Service]
User=lih
Group=www-data
WorkingDirectory=/home/lih/siteSchool
EnvironmentFile=/home/lih/siteSchool/.env
Environment="PATH=/home/lih/siteSchool/venv/bin:/usr/bin:/bin"
ExecStart=/home/lih/siteSchool/venv/bin/celery -A config worker -l info -c 12 -Q code_execution,default -n siteschool@%%h
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
